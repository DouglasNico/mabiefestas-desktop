{
  "name": "mabie-festas-gestao",
  "version": "1.0.6",
  "description": "Sistema Oficial de Gestão de Acervo, Orçamentos e Estoque - Mabie Festas",
  "main": "main.js",
  "scripts": {
    "bundle": "esbuild src/js/app.js --bundle --outfile=src/js/bundle.js --format=iife --platform=browser",
    "start": "npm run bundle && electron .",
    "build": "npm run bundle && electron-builder --win",
    "build:portable": "npm run bundle && electron-builder --win portable",
    "release": "npm run bundle && electron-builder --win --publish always"
  },
  "keywords": [
    "gestao",
    "estoque",
    "orcamento",
    "mabie-festas",
    "electron"
  ],
  "author": "Mabie Festas",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "firebase": "^11.4.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.mabiefestas.gestao",
    "productName": "Mabie Festas Gestão",
    "forceCodeSigning": false,
    "publish": {
      "provider": "github",
      "owner": "DouglasNico",
      "repo": "mabiefestas-desktop"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mabie Festas"
    }
  }
}
